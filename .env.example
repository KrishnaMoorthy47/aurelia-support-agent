# ---- LLM (free: Groq) ----
# Leave GROQ_API_KEY empty to run in OFFLINE mode (rule-based stand-in, no network).
GROQ_API_KEY=
LLM_PROVIDER=auto            # auto | groq | offline   (auto = groq if a key is set, else offline)
FAST_MODEL=qwen/qwen3.8-27b          # routing + critic (fast, cheap)
STRONG_MODEL=openai/gpt-oss-120b     # grounded answers
FAST_MAX_TOKENS=150                  # caps output: Groq free tier rejects requests that could exceed ~1000 output tokens/min
STRONG_MAX_TOKENS=800
REASONING_EFFORT=low                 # gpt-oss only: low keeps latency + free-tier tokens down
# Groq free tier (checked 2026-11-23): 1,000 requests/day and 8,000 tokens/min PER MODEL

# ---- Retrieval ----
EMBEDDER=auto                # auto | fastembed | lexical  (fastembed downloads a small free model on first run)
VECTOR_STORE=memory          # memory | pgvector
DATABASE_URL=                # Supabase Postgres connection string (only needed for VECTOR_STORE=pgvector / CHECKPOINTER=postgres)
CHECKPOINTER=memory          # memory | postgres
AUDIT_LOG=auto               # auto | postgres | memory | off  (auto = log POSTs and errors to Supabase table api_logs when DATABASE_URL is set)

# ---- Service ----
API_KEY=                     # optional: if set, /chat requires header X-API-Key
REVIEWER_KEY=                # optional: if set, approving/declining requires header X-Reviewer-Key
CORS_ORIGINS=*               # comma-separated origins allowed to call the API from a browser
RATE_LIMIT_PER_MINUTE=20
DEMO_DAILY_CAP=300           # total chat messages per day across all visitors (protects the free Groq quota); 0 = no cap
ESCALATION_WEBHOOK_URL=      # optional: called when a complaint is logged (n8n/Zapier/Slack can plug in here)
MOCK_DB_PATH=data/aurelia_mock.db

# ---- Tracing (free LangSmith tier, optional) ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aurelia-support-agent
